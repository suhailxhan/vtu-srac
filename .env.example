# SRAC — Environment Variables

# API Server
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Database (Supabase PostgreSQL)
# DATABASE_URL: Transaction Mode Pooler (port 6543) or direct connection (port 5432)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct session connection (port 5432) for Prisma schema sync (db push / migrations)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# VTU Results Portal
VTU_RESULTS_URL=https://results.vtu.ac.in/DJcbcs25/index.php

# Fetch Settings
FETCH_CONCURRENCY=2
FETCH_DELAY_MIN_MS=1000
FETCH_DELAY_MAX_MS=3000
FETCH_MAX_RETRIES=3

# CAPTCHA Timeout (ms)
CAPTCHA_TIMEOUT_MS=120000

# Reports Storage (defaults to /tmp/reports on Vercel)
REPORTS_DIR=./storage/reports

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
