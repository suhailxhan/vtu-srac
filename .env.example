# SRAC — Environment Variables

# API
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-secure-random-string
JWT_REFRESH_SECRET=change-this-to-another-secure-random-string
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Database (SQLite for hackathon demo)
DATABASE_URL="file:./dev.db"

# VTU Results Portal
VTU_RESULTS_URL=https://results.vtu.ac.in/DJcbcs25/index.php

# Fetch settings
FETCH_CONCURRENCY=2
FETCH_DELAY_MIN_MS=1000
FETCH_DELAY_MAX_MS=3000
FETCH_MAX_RETRIES=3

# Captcha timeout (ms)
CAPTCHA_TIMEOUT_MS=120000

# Reports storage
REPORTS_DIR=./storage/reports

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
